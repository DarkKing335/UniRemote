# Force consistent LF line endings for all text source files.
# Prevents CRLF/LF mixed diffs when collaborating across Windows/macOS/Linux.

* text=auto

*.kt    text eol=lf
*.kts   text eol=lf
*.xml   text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.pro   text eol=lf
*.gradle text eol=lf
*.properties text eol=lf
*.toml  text eol=lf

# Binary files — never touch line endings
*.png   binary
*.jpg   binary
*.jpeg  binary
*.ico   binary
*.webp  binary
*.ttf   binary
*.otf   binary
*.jar   binary
*.aar   binary
*.keystore binary
