<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug Network Security Config for UniRemote
  ─────────────────────────────────────────────────────────────────────────
    Allows cleartext for local interoperability testing in debug builds.
    Runtime policy still enforces LAN-only cleartext destinations.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
