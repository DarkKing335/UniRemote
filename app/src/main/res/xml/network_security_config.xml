<?xml version="1.0" encoding="utf-8"?>
<!--
  Network Security Config for UniRemote
  ─────────────────────────────────────────────────────────────────────────
    Production lock policy: cleartext traffic is fully disabled.
    Any transport that requires plaintext HTTP/ws:// must be migrated to
    secure alternatives before public release.
-->
<network-security-config>
    <!-- DLNA control/media transport is HTTP on local network; cleartext must stay enabled. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <!-- Trust system CAs for any HTTPS calls (e.g. Play Store, update checks) -->
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
